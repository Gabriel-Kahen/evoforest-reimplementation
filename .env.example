# Copy this file to .env and fill in one provider block.
# Never commit .env; it may contain API keys.

# Gemini
EVOFOREST_LLM_PROVIDER=gemini
GEMINI_API_KEY=replace-with-your-gemini-api-key
EVOFOREST_LLM_MODEL=replace-with-a-gemini-model-you-can-access

# OpenAI
# EVOFOREST_LLM_PROVIDER=openai
# OPENAI_API_KEY=replace-with-your-openai-api-key
# EVOFOREST_LLM_MODEL=replace-with-an-openai-model-you-can-access

# Claude
# EVOFOREST_LLM_PROVIDER=claude
# ANTHROPIC_API_KEY=replace-with-your-anthropic-api-key
# EVOFOREST_LLM_MODEL=replace-with-a-claude-model-you-can-access

# Optional shared settings
EVOFOREST_LLM_TIMEOUT_SECONDS=120
EVOFOREST_LLM_MAX_TOKENS=4096
